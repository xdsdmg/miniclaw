# ─── Miniclaw Environment Configuration ─────────────────────────────────────
# Copy this file to `.env` and fill in your values. Loaded automatically.
#
#   cp .env.example .env

# ─── LLM Provider ────────────────────────────────────────────────────────────

# Default provider used when none is specified via CLI.
# Options: deepseek (other providers can be added via miniclaw.json)
MINICLAW_DEFAULT_PROVIDER=deepseek

# DeepSeek API key (recommended)
DEEPSEEK_API_KEY=

# Generic LLM API key — used as a fallback by any provider
LLM_API_KEY=

# ─── Provider Model Overrides ────────────────────────────────────────────────
# Override the default model for a provider (optional)

# DeepSeek model
DEEPSEEK_MODEL=deepseek-v4-flash

# ─── Server ──────────────────────────────────────────────────────────────────

# Server authentication key (required when running `miniclaw server`)
MINICLAW_API_KEY=

# ─── Logging ─────────────────────────────────────────────────────────────────

# Log level: DEBUG | INFO | WARN | ERROR (default: INFO)
LOG_LEVEL=INFO
